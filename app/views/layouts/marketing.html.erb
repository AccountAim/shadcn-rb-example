<!DOCTYPE html>
<html class="<%= sui.theme_class(theme: preferences["theme"], mode: preferences["mode"]) %>">
  <head>
    <title><%= content_for(:title).presence || "shadcnrb" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
      body { font-family: "Inter", system-ui, sans-serif; }
      pre, code { font-family: "JetBrains Mono", ui-monospace, monospace; }
    </style>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= sui.codeblock_theme_styles %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-background text-foreground antialiased min-h-svh flex flex-col"
      data-controller="preferences" data-preferences-url-value="<%= preferences_path %>" data-action="shadcnrb--theme-switcher--component:change->preferences#save shadcnrb--sidebar--component:change->preferences#save">
    <%= sui.overlay_outlet %>
    <%= sui.toaster position: "bottom-right" %>

    <%= render "layouts/top_bar" %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <footer class="border-t py-6">
      <%= sui.layout.container size: :xl do %>
        <%= sui.layout.row justify: :between, wrap: true, class: "text-sm text-muted-foreground" do %>
          <span>Built with shadcnrb. MIT licensed.</span>
          <%= sui.layout.row gap: 4 do %>
            <%= link_to "Docs", docs_path, class: "hover:text-foreground" %>
            <%= link_to "Blocks", blocks_path, class: "hover:text-foreground" %>
            <%= link_to "GitHub", "https://github.com/accountaim/shadcn-rb", target: "_blank", rel: "noopener", class: "hover:text-foreground" %>
          <% end %>
        <% end %>
      <% end %>
    </footer>
  </body>
</html>
